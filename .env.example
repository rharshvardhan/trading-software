# Blank placeholders only. Copy to .env (git-ignored) and fill in locally.
# Dhan configuration will be supplied later; these names are not a finalized API contract.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Optional: alternative directory of fixture JSON files (defaults to the packaged fixture_data).
SCANNER_FIXTURE_DIR=
# Optional: cache directory for Dhan's daily instrument list (defaults to ./data, git-ignored).
SCANNER_DATA_DIR=
# Optional: directory of the built web UI (defaults to ./frontend/dist).
SCANNER_UI_DIR=
# Stop-loss logic switch: only "true" enables the 09:45 window's initial stop-loss level
# (THREE_CANDLE_0945_STOP_LOSS_SPEC.md); false, blank, or missing keeps it disabled.
STOP_LOSS_ENABLED=false
# Live updates: refresh every N seconds, anchored at the 09:15 open (09:15:08, then every N seconds).
# Allowed 15-300; blank or invalid falls back to 60.
LIVE_REFRESH_SECONDS=60
