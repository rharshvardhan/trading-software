{
  "name": "four-candle-scanner-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "concurrently --kill-others --names api,ui --prefix-colors blue,magenta \"pnpm run dev:api\" \"pnpm run dev:ui\"",
    "dev:api": "node scripts/check-python.mjs && ../.venv/bin/python -m uvicorn trading_scanner.api:app --host 127.0.0.1 --port 8000 --reload --reload-dir ../src",
    "dev:ui": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
